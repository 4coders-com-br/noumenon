# --- LLM endpoint (any Anthropic-Messages-API-compatible target) ---
#
# Examples:
#   Anthropic direct:  https://api.anthropic.com
#   OpenRouter:        https://openrouter.ai/api/v1
#   LiteLLM proxy:     http://localhost:4000
#   Z.ai gateway:      https://api.z.ai/api/anthropic
#
# Required for any LLM-touching subcommand (analyze, synthesize, ask, benchmark, …):
# NOUMENON_LLM_BASE_URL=https://api.anthropic.com
# NOUMENON_LLM_API_KEY=your-key-here

# Optional: default model id sent to the endpoint. --model on a subcommand
# overrides this per-call. Pass the exact id the upstream expects — Noumenon
# does not validate or alias model ids.
# NOUMENON_LLM_MODEL=claude-sonnet-4-6-20250514

# --- Server mode (docker compose) ---

# Required: admin token for managing the server
# Generate with: openssl rand -base64 32
# NOUMENON_TOKEN=change-me-to-a-random-secret

# Optional: webhook secret for GitHub/GitLab push notifications
# NOUMENON_WEBHOOK_SECRET=

# Optional: server tuning
# NOUMENON_PORT=7891
# NOUMENON_READ_ONLY=false
# NOUMENON_MAX_ASK_SESSIONS=50
# NOUMENON_MAX_LLM_CONCURRENCY=10
# NOUMENON_POLL_INTERVAL=5
# NOUMENON_LOG_FORMAT=text
